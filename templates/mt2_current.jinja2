{% extends "base.jinja2" %}

{% block title %}
  {% if save.in_game %}
    {{ save.champion.name }} run [{{ save.main_clan }} & {{ save.sub_clan }}]
  {% else %}
    No active run
  {% endif %}
{% endblock %}

{% block head %}
  {% if autorefresh %}
    <!-- Refresh the page every 15 seconds; savefile gets regularly updated.
         Actual code will properly cache the savefile and serve latest -->
    <meta http-equiv="refresh" content="15">
  {% endif %}
  <script src="/static/js/run.js"></script>
{% endblock %}

{% block content %}
  <script type="text/javascript">
    const labels = {{ save.get_fight_names() | safe }};

    const data = {
      labels: labels,
      datasets: [{
        label: 'Pyre HP',
        backgroundColor: '#ff6384',
        borderColor: '#ff6384',
        data: {{ save.pyre_hp_graph }},
        yAxisID: 'y',
      },{
        label: 'Pyre Max HP',
        backgroundColor: '#8463ff',
        borderColor: '#8463ff',
        borderWidth: 1,
        radius: 0,
        data: {{ save.pyre_max_hp_graph }},
        yAxisID: 'y',
      },{
        label: 'Gold',
        backgroundColor: '#ffd700',
        borderColor: '#ffd700',
        data: {{ save.gold_graph }},
        yAxisID: 'y1',
      }]
    };

    const config = {
      type: 'line',
      data: data,
      options: {
        responsive: true,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        stacked: false,
        scales: {
          x: {
            grid: {
              color: "#222229",
            }
          },
          y: {
            min: 0,
            grid: {
              color: "#222229",
            }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            min: 0,
            grid: {
              color: "#222229",
              drawOnChartArea: false, // only want the grid lines for one axis to show up
            },
          },
        }
      }
    };
  </script>

  {% if save.in_game %}
    <section id="top-section" class="section">
        <div class="avatar">
          <img class="{{ save.champion.name | lower }}"
            src="{{ save.champion.get_image_link() }}"
            alt="{{ save.champion.name }}"/>
            {{ save.main_class }} / {{ save.sub_class }} run
        </div><br>
      <div id="run-info" class="columns is-marginless">
        <div class="column message neow is-paddingless is-marginless box">
            <div class="message-header">
              <p id="neow-header">Starting bonus</p>
            </div>
            <div id="neow-body-original" class="message-body">
            {# no way I can tell to see the cards given to us at the start #}
          </div>
          <div id="neow-body-new" class="message-body hidden">
            <p id="neow-body-content"></p>
          </div>
        </div>

        <div class="column is-one-fifth">
          <div class="clans pyre columns is-centered">
            <p>
              {{ save.main_clan_icon | safe }}
              <img class="pyre"
                src="{{ save.pyre.image }}"
                alt="{{ save.pyre.name }}"
                title="{{ save.pyre.name }}"
                onclick="neowText('{{ save.pyre.name | replace("'", "\\'") }}', '{{ save.pyre.escaped_description() }}')">
              {{ save.sub_clan_icon | safe }}
            </p>
          </div>
          <div class="pyre-hp columns is-centered">
            {{ save.pyre_hp }} / {{ save.pyre_max_hp }}
            <img class="pyre-hp"
              src="/static/mt2/icons/PyreHealth.png"
              alt="Pyre Health"
              height="32"
              width="32"/>
          </div>
          {% if save.mutators %}
          <div>
            <p>
            {% for mutator in save.mutators %}
              <img class="mutator"
                src="{{ mutator.image }}"
                alt="{{ mutator.name }}"
                title="{{ mutator.name }}"
                width="64" height="64"
                onclick="neowText('{{ mutator.name | replace("'", "\\'") }}', '{{ mutator.escaped_description() }}')">
            {% endfor %}
            </p>
          </div>
          {% endif %}
          <div class="hint" onclick="neowReset()">
          <p>Hint: you can click on artifacts, cards, map nodes, Pyre, and mutators.</p>
          </div>
        </div>

        <div class="column message relics-message is-paddingless is-marginless box">
          <div class="message-header">
            <p>Artifacts</p>
          </div>
          <div class="message-body relics">
            {% for relic in save.artifacts %}
              <div>
                <img src="{{ relic.image }}"
                  alt="{{ relic.name }}"
                  title="{{ relic.name }}"
                  onclick="neowText('{{ relic.name | replace("'", "\\'") }}', '{{ relic.escaped_description() }}')" >
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="box mt2-run is-paddingless">
        <div class="mt2-run-content">
          <div class="run-title pt-4 pr-4 pb-4">

            <div class="extra"> {# Add misc info here#}
            </div>

          </div>
        </div>
        <section class="section">
          <div class="charts">
            <canvas id="chart"></canvas>
            <script type="text/javascript">
            const myChart = new Chart(
              document.getElementById('chart'),
              config
            );
            </script>

            <p class="chart-disclaimer has-text-centered m-4 is-size-7">
              This graph is not excellent on mobile yet. View it on desktop for a
              better and more interactive experience.
            </p>
          </div>
        </section>
      </div>
    </section>
  {% else %}
    <section class="section mt-4 mb-4">
      <div class="columns is-centered has-text-centered mt-4">
        <div class="column mb-4">
          <h1 class="title">
            No run is currently going on!
          </h1>
          <p class="block">
            Stick around until Baalor starts one.
          </p>
        </div>
      </div>
    </section>
  {% endif %}

{% endblock %}
